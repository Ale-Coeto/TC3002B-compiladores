grammar(semantics: &mut Semantics, quad_generator: &mut QuadGenerator);
use crate::scanner::Token;
use crate::semantics::Semantics;
use crate::quads::QuadGenerator;
use crate::semantics::func_types::FuncType;
use crate::semantics::var_types::VarType;
use crate::quads::operator_group::OperatorGroup;
use crate::quads::quad_operators::QuadOperator;
use crate::quads::quad_value::QuadValue;

extern {
    type Location = usize;
    type Error = ();
    
    enum Token {
        "programa" => Token::Programa,
        "inicio" => Token::Inicio,
        "fin" => Token::Fin,
        "entero" => Token::Entero,
        "flotante" => Token::Flotante,
        "vars" => Token::Variable,
        "escribe" => Token::Escribe,
        "nula" => Token::Nula,
        "mientras" => Token::Mientras,
        "haz" => Token::Haz,
        "si" => Token::Si,
        "sino" => Token::Sino,
        ";" => Token::PuntoYComa,
        ":" => Token::DosPuntos,
        "," => Token::Coma,
        "{" => Token::LlaveAbrir,
        "}" => Token::LlaveCerrar,
        "[" => Token::CorcheteAbrir,
        "]" => Token::CorcheteCerrar,
        "(" => Token::ParentesisAbrir,
        ")" => Token::ParentesisCerrar,
        "==" => Token::ComparadorIgual,
        "!=" => Token::NoIgual,
        ">" => Token::Mayor,
        "<" => Token::Menor,
        "=" => Token::Igual,
        "+" => Token::Mas,
        "-" => Token::Menos,
        "*" => Token::Multiplicar,
        "/" => Token::Dividir,
        
        Entero => Token::ConstanteEntero(<i64>),
        Flotante => Token::ConstanteFlotante(<f64>),
        Letrero => Token::Letrero(<String>),
        Identificador => Token::Identificador(<String>),
    }
}

// Punto neurálgico 6 (final)
pub Programa: () = {
    ProgramaSemantics ProgramaIdSemantics ";" OpcionesPrograma "inicio" Cuerpo "fin" => {
        let _ = semantics.dir_func.delete_all();
    }
};

// Punto neurálgico 1
pub ProgramaSemantics: () = {
    "programa" => {
        let _ = semantics.dir_func.create_dir_func();
    }
}

// Punto neurálgico 2
pub ProgramaIdSemantics: () = {
    <_id:Identificador> => {
        let _ = semantics.dir_func.add_func(_id.clone(), FuncType::Program);
        let _ = semantics.dir_func.add_func(format!("global-{}", _id.clone()).to_string(), FuncType::Nula);
    }
}

OpcionesPrograma: () = {
    Vars ListaFuncs => (),
    ListaFuncs => (),
};

ListaFuncs: () = {
    Funcs ListaFuncs => (),
    => (),
};

Vars: () = {
    VarsNewTable ListaVars => (),
};

// Punto neurálgico 3
VarsNewTable: () = {
    "vars" => {
        let _ = semantics.dir_func.create_var_table();
    }
};

ListaVars: () = {
    ListaId ":" Tipo ";" AgregarVars => (),
};

ListaId: () = {
    NewVar AgregarId => (),
};

// Punto neurálgico 4
NewVar: () = {
    <_id:Identificador> => {
        let _ = semantics.dir_func.add_var_name(_id.clone());
    }
};

AgregarId: () = {
    "," ListaId => (),
    => (),
};

AgregarVars: () = {
    ListaVars => (),
    => (),
};

Funcs: () = {
    AddFuncSemantics DefFunc => (),
};

AddFuncSemantics: () = {
    "nula" <_id:Identificador> => {
        let _ = semantics.dir_func.add_func(_id.clone(), FuncType::Nula);
    },
    "entero" <_id:Identificador> => {
        let _ = semantics.dir_func.add_func(_id.clone(), FuncType::Entero);
    },
    "flotante" <_id:Identificador> => {
        let _ = semantics.dir_func.add_func(_id.clone(), FuncType::Flotante);
    }
}

DefFunc: () = {
    "(" ListaArgs ")" "{" OpcionVars Cuerpo "}" ";" => (),
};

ListaArgs: () = {
    Args => (),
    => (),
};

Args: () = {
    ArgsVarSemantics AgregarArgs => (),
};

// Punto neurálgico 5
ArgsVarSemantics: () = {
    <_id:Identificador> ":" Tipo => {
        let _ = semantics.dir_func.add_var_name(_id.clone());
    }
};

AgregarArgs: () = {
    "," Args => (),
    => (),
};

OpcionVars: () = {
    Vars => (),
    => (),
};

Cuerpo: () = {
    "{" ListaEstatuto "}" => (),
};

ListaEstatuto: () = {
    Estatuto ListaEstatuto => (),
    => (),
};

Tipo: () = {
    "entero" => {
        let _ = semantics.dir_func.add_vars(VarType::Entero);
    },
    "flotante" => {
        let _ = semantics.dir_func.add_vars(VarType::Flotante);
    },
};

Estatuto: () = {
    PushId AsignaOLlamada => (),
    Condicion => (),
    Ciclo => (),
    Imprime => (),
    "[" ListaEstatutoAdentro "]" => (),
};

ListaEstatutoAdentro: () = {
    Estatuto ListaEstatutoAdentro => (),
    => (),
};

AsignaOLlamada: () = {
    // Punto neurálgico Quads 8
    "=" Expresion ";" => {
        quad_generator.equals_quad();
    },
    LlamadaSinId => (),
};

Condicion: () = {
    "si" "(" Expresion ")" Cuerpo OpcionSino ";" => (),
};

OpcionSino: () = {
    "sino" Cuerpo => (),
    => (),
};

Ciclo: () = {
    "mientras" "(" Expresion ")" "haz" Cuerpo ";" => (),
};

LlamadaSinId: () = {
    "(" ListaExpresion ")" ";" => (),
};

Llamada: () = {
    <_id:Identificador> LlamadaSinId => (),
};

ListaExpresion: () = {
    Expresion AgregarExpresion => (),
    => (),
};

AgregarExpresion: () = {
    "," Expresion AgregarExpresion => (),
    => (),
};

Imprime: () = {
    "escribe" "(" OpcionImprime ")" ";" => (),
};

OpcionImprime: () = {
    ElementoImprime AgregarOpcionImprime => (),
};

ElementoImprime: () = {
    Expresion => (),
    <_l:Letrero> => (),
};

AgregarOpcionImprime: () = {
    "," ElementoImprime AgregarOpcionImprime => (),
    => (),
};

Expresion: () = {
    Exp OpcionExp => (),
};

OpcionExp: () = {
    PushMayor Exp ChecarRel => (),
    PushMenor Exp ChecarRel => (),
    PushNoIgual Exp ChecarRel => (),
    PushIgual Exp ChecarRel => (),
    => (),
};

Exp: () = {
    Termino AgregarTermino => (),
};

// Punto neurálgico Quads 4
pub ChecarSumSub: () = {
    => { 
        quad_generator.check_operator(OperatorGroup::SumSub)
    }
};

AgregarTermino: () = {
    // Punto neurálgico Quads 3
    PushMas Termino ChecarSumSub AgregarTermino => (),
    // Punto neurálgico Quads 3
    PushMenos Termino ChecarSumSub AgregarTermino => (),
    => (),
};

// Punto neurálgico Quads 3
pub PushMas: () = {
    "+" => {
        quad_generator.push_operator(QuadOperator::Mas);
    }
}

// Punto neurálgico Quads 3
pub PushMenos: () = {
    "-" => {
        quad_generator.push_operator(QuadOperator::Menos);
    }
}

Termino: () = {
    Factor AgregarFactor => (),
};

// Punto neurálgico Quads 6
pub ChecarMultDiv: () = {
    => {
        quad_generator.check_operator(OperatorGroup::MultDiv)
    }
};

AgregarFactor: () = {
    // Punto neurálgico Quads 5
    PushMult Factor ChecarMultDiv AgregarFactor => (),
    // Punto neurálgico Quads 5
    PushDiv Factor ChecarMultDiv AgregarFactor => (),
    => (),
};

// Punto neurálgico Quads 5
pub PushMult: () = {
    "*" => {
        quad_generator.push_operator(QuadOperator::Multiplicar);
    }
}

// Punto neurálgico Quads 5
pub PushDiv: () = {
    "/" => {
        quad_generator.push_operator(QuadOperator::Dividir);
    }
}

// Punto neurálgico Quads 7
pub ChecarRel: () = {
    => {
        quad_generator.check_operator(OperatorGroup::Rel)
    }
};

// Punto neurálgico Quads 7
pub PushMayor: () = {
    ">" => {
        quad_generator.push_operator(QuadOperator::Mayor);
    }
}


// Punto neurálgico Quads 7
pub PushMenor: () = {
    "<" => {
        quad_generator.push_operator(QuadOperator::Menor);
    }
}


// Punto neurálgico Quads 7
pub PushNoIgual: () = {
    "!=" => {
        quad_generator.push_operator(QuadOperator::NoIgual);
    }
}


// Punto neurálgico Quads 7
pub PushIgual: () = {
    "==" => {
        quad_generator.push_operator(QuadOperator::ComparadorIgual);
    }
}

Factor: () = {
    "(" Expresion ")" => (),
    Signo Valor => (),
    // Punto neurálgico Quads 2
    <_c:Constante> => { quad_generator.push_constante(_c); },
    PushId OpcionFactorId=> (),
};

// Punto neurálgico Quads 1
pub PushId: () = {
    <_id:Identificador> => {
        if let Ok((address, var_type)) = semantics.dir_func.get_var_info(&_id.clone()) {
            quad_generator.push_id(address, var_type);
        }
    }
};

OpcionFactorId: () = {
    LlamadaSinId => (),
    => (),
};

Signo: () = {
    "-" => (),
    "+" => (),
};

Valor: () = {
    <_id:Identificador> => (),
    <_c:Constante> => (),
};

Constante: QuadValue = {
    <_c:Entero> => { 
        QuadValue::Entero(_c) 
    },
    <_c:Flotante> => { 
        QuadValue::Flotante(_c) 
    },
};
